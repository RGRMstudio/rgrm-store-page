# DeepSource Configuration for RGRM Studio
# Phase 01: Brutalist Lineage

version = 1

[[analyzers]]
name = "javascript"
enabled = true
  [analyzers.meta]
  environment = ["browser", "node"]
  frameworks = ["react", "nextjs"]
  # Ensures the inspector uses your preferred architectural standards
  style_guide = "airbnb" 

[[analyzers]]
name = "secrets"
enabled = true
# Protects your STRIPE_SECRET_KEY and PRINTFUL_ID from exposure

[[analyzers]]
name = "test-coverage"
enabled = true

[exclude_patterns]
# We ignore the "temporary scaffolding"
patterns = [
  "node_modules/**",
  ".next/**",
  "out/**",
  "public/**",
  "*.config.js"
]

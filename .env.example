# ==============================================================================
# RGRM BAUHAUS STORE - ENVIRONMENT TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to a new file named .env.local
# 2. Fill in the actual keys from your Stripe and Discord dashboards.
# 3. .env.local is already in .gitignore and will NOT be pushed to GitHub.
# ==============================================================================

# --- STRIPE CONFIGURATION (SERVER-SIDE) ---
# Found at: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_51...your_secret_key_here

# --- STRIPE CONFIGURATION (CLIENT-SIDE) ---
# Prefixed with NEXT_PUBLIC_ to make it accessible to the browser
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51...your_public_key_here

# --- PRODUCT SETTINGS ---
# The specific Price ID for your Bauhaus Identity Registration product
STRIPE_PRICE_ID=price_1...your_price_id_here

# --- DISCORD NOTIFICATIONS ---
# Your unique Discord Webhook URL for sales and build alerts
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...your_webhook_here

# --- DEPLOYMENT SETTINGS ---
# Local development: http://localhost:3000
# Production: https://raguiromo.store
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- VERCEL ANALYTICS ---
# Automatically handled by Vercel, but listed here for consistency
VERCEL_ANALYTICS_ID=
